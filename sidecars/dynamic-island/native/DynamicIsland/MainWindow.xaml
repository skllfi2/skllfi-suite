<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Studio (AppWatch WinUI 3 Edition)"
        Width="660" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Grid x:Name="RootLayout" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
        <!-- Master Morphing Container styled with AppWatch Mica/Dark Surface -->
        <Border x:Name="MainIslandCard"
                Width="520" Height="44"
                CornerRadius="22"
                Background="{StaticResource Win11Bg}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.65" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- ══════════════════════════════════════════════════════════════
                     COMPACT BAR (Always Visible Top Layer)
                     ══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="CompactBar" Height="44" VerticalAlignment="Top" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="CompactBar_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status & Active Project Badge -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="⠿" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="SizeAll" ToolTip="Зажмите для свободного перемещения"/>
                        
                        <!-- Pulsing Glow Dot -->
                        <Grid Width="12" Height="12" Margin="0,0,8,0">
                            <Ellipse x:Name="StatusDotGlow" Width="12" Height="12" Fill="{StaticResource SuccessSubtleBrush}"/>
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="StatusLabel" Text="AGY" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Project Pill Badge (AppWatch style) -->
                        <Border x:Name="ProjectPill" Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,8,0" Cursor="Hand" ToolTip="Активный воркспейс Antigravity" PreviewMouseLeftButtonDown="ProjectPill_PreviewMouseDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 " FontSize="10"/>
                                <TextBlock x:Name="ActiveProjectName" Text="AppWatch" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text=" ▾" Foreground="{StaticResource TextTertiaryBrush}" FontSize="9" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Active Task Ticker -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" ClipToBounds="True">
                        <TextBlock x:Name="ActiveTaskTicker" 
                                   Text="AppWatch WinUI 3 Design System &amp; Full Live Sync" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="11" 
                                   FontWeight="Normal"
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Right: Quick Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Cost Badge -->
                        <Border x:Name="CostBadge" Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💎 " FontSize="9"/>
                                <TextBlock x:Name="CostMetricText" Text="0.08" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Safe Undo Button -->
                        <Border x:Name="BtnRollback" Background="{StaticResource WarningSubtleBrush}" BorderBrush="{StaticResource WarningPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Откат хода (Safe Undo Checkpoint)" PreviewMouseLeftButtonDown="BtnRollback_PreviewMouseDown">
                            <TextBlock Text="↺" Foreground="{StaticResource WarningBrush}" FontSize="12" FontWeight="Bold"/>
                        </Border>

                        <!-- Quick Settings Button -->
                        <Border x:Name="BtnQuickSettings" Background="{StaticResource NeutralSubtleBrush}" BorderBrush="{StaticResource NeutralPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,4,0" Cursor="Hand" ToolTip="Настройки оверлея" PreviewMouseLeftButtonDown="BtnQuickSettings_PreviewMouseDown">
                            <TextBlock Text="⚙" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Border>

                        <!-- Emergency Kill Switch -->
                        <Border x:Name="BtnKillSwitch" Background="{StaticResource CriticalSubtleBrush}" BorderBrush="{StaticResource CriticalPillBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Cursor="Hand" ToolTip="Экстренная остановка агента (Kill Switch)" PreviewMouseLeftButtonDown="BtnKillSwitch_PreviewMouseDown">
                            <TextBlock Text="🛑" FontSize="9"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════
                     EXPANDED TRAY (AppWatch WinUI 3 Navigation & Hub)
                     ══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="ExpandedTray" Margin="14,48,14,14" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Row 0: Quick Command Bar -->
                        <RowDefinition Height="Auto"/> <!-- Row 1: AppWatch Pivot Navigation -->
                        <RowDefinition Height="*"/>    <!-- Row 2: Active Tab Viewport -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Quick AI Command Prompt Box -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚡" FontSize="12" Foreground="{StaticResource AccentHighlightBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <TextBox x:Name="PromptInputBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI" VerticalAlignment="Center" KeyDown="PromptInputBox_KeyDown"/>
                            <Button Grid.Column="2" Content="Send" Style="{StaticResource Win11AccentButton}" Padding="10,4" FontSize="11" Click="BtnSendPrompt_Click"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: AppWatch Style Navigation Tabs -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabStatus" Content="📊 Активность" Style="{StaticResource AppWatchNavTab}" Foreground="{StaticResource AccentHighlightBrush}" FontWeight="SemiBold" Click="Tab_Click" Tag="PanelStatus"/>
                            <Button x:Name="TabProjects" Content="📁 Проекты" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelProjects"/>
                            <Button x:Name="TabSkills" Content="🧠 Навыки" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelSkills"/>
                            <Button x:Name="TabSessions" Content="💬 Сессии" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelSessions"/>
                            <Button x:Name="TabLauncher" Content="🚀 Инструменты" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelLauncher"/>
                            <Button x:Name="TabDiffs" Content="📝 Diffs" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelDiffs"/>
                            <Button x:Name="TabAppearance" Content="🎨 Внешний вид" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelAppearance"/>
                            <Button x:Name="TabSettings" Content="⚙ Настройки" Style="{StaticResource AppWatchNavTab}" Click="Tab_Click" Tag="PanelSettings"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: View Panels Container -->
                    <Grid Grid.Row="2">
                        
                        <!-- Panel 1: Activity & Telemetry (AppWatch Style Hero & Metrics) -->
                        <StackPanel x:Name="PanelStatus" Visibility="Visible">
                            <!-- 4 Telemetry Metrics Cards -->
                            <Border Style="{StaticResource AppWatchCard}" Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="АКТИВНЫЙ ПРОЕКТ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="CardProjectText" Text="AppWatch (active)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentHighlightBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ТЕКУЩАЯ МОДЕЛЬ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="Gemini 3.8 Flash" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ТОКЕНЫ / РАСХОД" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="CardCostText" Text="$0.08 / ~28k" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="LOOP GUARD" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock Text="Armed (2x Max)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentHighlightBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Current Task Banner -->
                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ТЕКУЩАЯ ЗАДАЧА В РАБОТЕ:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        <TextBlock x:Name="ActivityTaskDetail" Text="AppWatch WinUI 3 Redesign &amp; Antigravity Live Sync" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Background="{StaticResource SuccessSubtleBrush}" BorderBrush="{StaticResource SuccessPillBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="In Progress" FontSize="9" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Live Terminal Console -->
                            <Border Background="#111114" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Height="150">
                                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ConsoleLog" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Panel 2: Projects Hub (Strict Antigravity Sync) -->
                        <StackPanel x:Name="PanelProjects" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="РАБОЧИЕ ПРОЕКТЫ ANTIGRAVITY:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Добавить папку" Style="{StaticResource Win11Button}" Padding="8,3" FontSize="10" Margin="0,0,6,0" Click="BtnAddFolder_Click"/>
                                    <Button Content="↻ Обновить" Style="{StaticResource Win11Button}" Padding="8,3" FontSize="10" Click="BtnRefreshProjects_Click"/>
                                </StackPanel>
                            </Grid>
                            
                            <ScrollViewer Height="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ProjectsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBg}" BorderBrush="{Binding CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonDown="ProjectItem_Click" Tag="{Binding FullPath}">
                                                <Grid>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding StatusDot}" Foreground="{Binding DotColor}" FontSize="12"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <Border Background="{Binding BadgeBg}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" Visibility="{Binding BadgeVisibility}">
                                                                <TextBlock Text="Active Workspace" FontSize="8" Foreground="{StaticResource AccentHighlightBrush}" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FullPath}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Content="Выбрать" Style="{StaticResource Win11Button}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" FontSize="10" Click="ProjectItem_Click" Tag="{Binding FullPath}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Panel 2.5: Antigravity Skills Hub -->
                        <StackPanel x:Name="PanelSkills" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="СПЕЦИАЛИЗИРОВАННЫЕ НАВЫКИ АГЕНТА (AGENT SKILLS):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <ScrollViewer Height="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SkillsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Запустить" Style="{StaticResource Win11AccentButton}" Padding="10,4" FontSize="10" Click="SkillRun_Click" Tag="{Binding Command}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Panel 2.8: Antigravity Live Sessions Hub (НОВАЯ ФИЧА!) -->
                        <StackPanel x:Name="PanelSessions" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="ИСТОРИЯ И ЖИВЫЕ ДИАЛОГИ ANTIGRAVITY:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="↻ Синхронизировать" Style="{StaticResource Win11Button}" HorizontalAlignment="Right" Padding="8,3" FontSize="10" Click="BtnRefreshSessions_Click"/>
                            </Grid>

                            <ScrollViewer Height="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SessionsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="8" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Preview}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding StepCountInfo}" FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Panel 3: Quick Launcher (Чистые плитки + Кнопка «Настроить») -->
                        <StackPanel x:Name="PanelLauncher" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="БЫСТРЫЙ ЗАПУСК ИНСТРУМЕНТОВ РАЗРАБОТЧИКА" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnToggleEditTools" Content="✏️ Настроить" Style="{StaticResource Win11Button}" Padding="8,3" FontSize="10" Margin="0,0,6,0" Click="BtnToggleEditTools_Click"/>
                                    <Button x:Name="BtnAddTool" Content="+ Добавить" Style="{StaticResource Win11AccentButton}" Padding="8,3" FontSize="10" Click="BtnAddTool_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tool Grid: AppWatch Tile Buttons -->
                            <ScrollViewer Height="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ToolsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AppWatchTileButton}" Click="LaunchItem_Click" Tag="{Binding Command}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="✕" Style="{StaticResource Win11Button}" Foreground="{StaticResource ErrorBrush}" Padding="6,2" FontSize="9" Click="DeleteTool_Click" Tag="{Binding Id}" ToolTip="Удалить инструмент" Visibility="{Binding DeleteVisibility}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Panel 4: Diffs & Notes -->
                        <StackPanel x:Name="PanelDiffs" Visibility="Collapsed">
                            <Border Style="{StaticResource AppWatchCard}" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ПОНЯТНОЕ РЕЗЮМЕ ИЗМЕНЕНИЙ (EXPLAIN DIFF)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHighlightBrush}"/>
                                        <TextBlock Text="• Что изменено: Полный редизайн под AppWatch WinUI 3 Design System&#x0a;• Добавлено: Синхронизация живых сессий Antigravity, новая вкладка 'Сессии'&#x0a;• Цветовая модель: Mica Alt, Acrylic картриджи, аутентичные отступы и бордеры" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" LineHeight="16"/>
                                    </StackPanel>
                                    <Button Content="↺ Откатить ход..." Style="{StaticResource Win11Button}" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource WarningBrush}" Padding="8,3" FontSize="10" Click="TriggerRollbackWithConfirm"/>
                                </Grid>
                            </Border>

                            <Border Background="#111114" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Height="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="11" LineHeight="17">
                                        <Run Text="@@ AppWatch Fluent Overhaul @@" Foreground="{StaticResource TextTertiaryBrush}"/><LineBreak/>
                                        <Run Text="+ Ported WinUI 3 Design Tokens directly from AppWatch/DesignSystem.xaml" Foreground="{StaticResource SuccessBrush}"/><LineBreak/>
                                        <Run Text="+ Added Antigravity Live Sessions synchronization tab" Foreground="{StaticResource SuccessBrush}"/><LineBreak/>
                                        <Run Text="+ Clean interactive tool tiles with dedicated edit mode" Foreground="{StaticResource SuccessBrush}"/><LineBreak/>
                                        <Run Text="+ True Windows 11 Segoe UI Variable typography &amp; micro-strokes" Foreground="{StaticResource SuccessBrush}"/>
                                    </TextBlock>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Panel 5: Appearance / Form-Factor Switcher -->
                        <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                            <TextBlock Text="ФОРМ-ФАКТОР И РЕЖИМЫ ОТОБРАЖЕНИЯ (APPWATCH STYLED)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource AppWatchCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Выберите форм-фактор (изменение применяется сразу):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <UniformGrid Columns="2" Rows="2">
                                        <Button x:Name="BtnBarStyle" Content="🖥️ Island Bar (Капсула)" Style="{StaticResource Win11AccentButton}" Margin="0,0,4,4" Click="ThemeStyle_Click" Tag="bar"/>
                                        <Button x:Name="BtnTopBarStyle" Content="🔝 Верхний сайд-бар (Top Bar)" Style="{StaticResource Win11Button}" Margin="4,0,0,4" Click="ThemeStyle_Click" Tag="top-bar"/>
                                        <Button x:Name="BtnSideBarStyle" Content="📌 Боковой сайд-бар (Side Dock)" Style="{StaticResource Win11Button}" Margin="0,4,4,0" Click="ThemeStyle_Click" Tag="side-dock"/>
                                        <Button x:Name="BtnPillStyle" Content="💊 Minimal Pill" Style="{StaticResource Win11Button}" Margin="4,4,0,0" Click="ThemeStyle_Click" Tag="pill"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource AppWatchCard}">
                                <StackPanel>
                                    <TextBlock Text="ЦВЕТОВОЙ АКЦЕНТ WINUI 3" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Content="AppWatch Blue" Style="{StaticResource Win11Button}" Margin="0,0,6,0" Click="ColorAccent_Click" Tag="#0078D4"/>
                                        <Button Content="WinUI Cyan" Style="{StaticResource Win11Button}" Margin="0,0,6,0" Click="ColorAccent_Click" Tag="#60CDFF"/>
                                        <Button Content="Изумрудный" Style="{StaticResource Win11Button}" Margin="0,0,6,0" Click="ColorAccent_Click" Tag="#2EA043"/>
                                        <Button Content="Пурпурный" Style="{StaticResource Win11Button}" Click="ColorAccent_Click" Tag="#C084FC"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Panel 6: Settings -->
                        <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                            <!-- Memory & Cache Cleaner -->
                            <Border Style="{StaticResource AppWatchCard}" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="ОЧИСТКА ВРЕМЕННОГО КЭША И ЛОГОВ BRAIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHighlightBrush}"/>
                                        <TextBlock Text="Освобождает место и ускоряет работу агента" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Content="🧹 Очистить кэш" Style="{StaticResource Win11Button}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" Click="BtnCleanBrain_Click"/>
                                </Grid>
                            </Border>

                            <!-- Docking Presets -->
                            <Border Style="{StaticResource AppWatchCard}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="ПОЗИЦИЯ НА ЭКРАНЕ (DOCKING)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,4">
                                        <Button Content="Сверху по центру" Style="{StaticResource Win11Button}" Margin="0,0,6,6" Click="Preset_Click" Tag="top-center"/>
                                        <Button Content="Сверху слева" Style="{StaticResource Win11Button}" Margin="0,0,6,6" Click="Preset_Click" Tag="top-left"/>
                                        <Button Content="Сверху справа" Style="{StaticResource Win11Button}" Margin="0,0,6,6" Click="Preset_Click" Tag="top-right"/>
                                        <Button Content="Снизу по центру" Style="{StaticResource Win11Button}" Margin="0,0,6,6" Click="Preset_Click" Tag="bottom-center"/>
                                        <Button Content="Снизу справа" Style="{StaticResource Win11Button}" Margin="0,0,6,6" Click="Preset_Click" Tag="bottom-right"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Opacity & Always on Top -->
                            <Border Style="{StaticResource AppWatchCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Поверх всех окон (Always on top)" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="TopmostCheck" Grid.Column="1" IsChecked="True" Checked="Topmost_Checked" Unchecked="Topmost_Unchecked"/>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                        <Grid>
                                            <TextBlock Text="Прозрачность Mica Alt" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="OpacityValueText" Text="98%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentHighlightBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="0.98" Margin="0,6,0,0" ValueChanged="OpacitySlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
