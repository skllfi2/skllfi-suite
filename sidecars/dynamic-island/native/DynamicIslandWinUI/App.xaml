<Application
    x:Class="DynamicIslandWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- AppWatch Semantic Colors & Brushes -->
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0086F0" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F0078D4" />
            <SolidColorBrush x:Key="AccentPillBorderBrush" Color="#440078D4" />
            <SolidColorBrush x:Key="AccentHighlightBrush" Color="#60CDFF" />

            <SolidColorBrush x:Key="SuccessBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1F2EA043" />
            <SolidColorBrush x:Key="SuccessPillBorderBrush" Color="#332EA043" />

            <SolidColorBrush x:Key="WarningBrush" Color="#FFB900" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#22FFB900" />
            <SolidColorBrush x:Key="WarningPillBorderBrush" Color="#44FFB900" />

            <SolidColorBrush x:Key="ErrorBrush" Color="#D83B01" />
            <SolidColorBrush x:Key="CriticalSubtleBrush" Color="#1FD83B01" />
            <SolidColorBrush x:Key="CriticalPillBorderBrush" Color="#33D83B01" />

            <SolidColorBrush x:Key="NeutralSubtleBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NeutralPillBorderBrush" Color="#26FFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCFD8" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8E8E9A" />

            <!-- AppWatch Card Styles -->
            <Style x:Key="AppWatchCardBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefault}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefault}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="AppWatchTileButton" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefault}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefault}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
